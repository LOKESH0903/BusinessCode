@page
@model IndexModel
@{
	ViewData["Title"] = "Home page";
}

<div class="text-center" style="display:none">
	<h1 class="display-4">Welcome</h1>
	<p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>


<div class="card mt-4">
	<div class="col-md-12">
		<button id="btnDownloadReport" type="button" class="btn btn-primary">Download Report</button>
	</div>
	<div class="card-header">
		<h5 class="mb-0">Vendor Payment Reports</h5>
	</div>
	<div class="card-body p-0">
		<div class="table-responsive">
			<table id="tblVendorPurchasePaymentReport" style="border: 2px solid black;border-radius:5px;" class="table table-striped table-bordered mb-0">
				<thead class="table-light">
					<tr>
						<td colspan="8" class="text-center py-3"><h2>  Pending payment details till  @DateTime.Now.ToString("dd/MM/yyyy")  </h2></td>
					</tr>
					<tr>
						<th scope="col">Vendor Name</th>
						<th scope="col">Invoice #</th>
						<th scope="col">Order Date</th>
						<th scope="col">Bill Amount</th>
						<th scope="col">Paid Amount</th>
						<th scope="col">Due Amount</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.VendorPurchagePendingDetails != null && Model.VendorPurchagePendingDetails.Any())
					{
						foreach (var r in Model.VendorPurchagePendingDetails)
						{
							if (r.TotalPurchaseDays > 45)
							{
								<tr style="background-color: #f8d7da;">
									<td style="background-color:red">@r.VendorName</td>
									<td style="background-color:red">@r.InvoiceNumber</td>
									<td style="background-color:red">@r.OrderDate</td>
									<td style="background-color:red">@r.PurchaseAmount.ToString("C")</td>
									<td style="background-color:red">@r.PaidAmount.ToString("C")</td>
									<td style="background-color:red">@(r.PurchaseAmount - r.PaidAmount)</td>
								</tr>
							}
							else
							{
								<tr>
									<td>@r.VendorName</td>
									<td>@r.InvoiceNumber</td>
									<td>@r.OrderDate</td>
									<td>@r.PurchaseAmount.ToString("C")</td>
									<td>@r.PaidAmount.ToString("C")</td>
									<td>@(r.PurchaseAmount - r.PaidAmount)</td>
								</tr>
							}
						}
						<tr>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {
	<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
	<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>
	<script>
		$("#btnDownloadReport").click(function() {
			var dt = new Date();
				html2canvas($('#tblVendorPurchasePaymentReport')[0], {
				onrendered: function (canvas) {
					var data = canvas.toDataURL();
					var docDefinition = {
						content: [{
							image: data,
							width: 500
						}]
					};
					pdfMake.createPdf(docDefinition).download("VendorPurchasePaymentReport"+dt.getDate() + "_" + (dt.getMonth() + 1) + "_" + dt.getFullYear() +"_"+ dt.getHours() + "_" + dt.getMinutes() + "_" + dt.getSeconds()+".pdf");
				}
			});
		});
	</script>
}

@page
@model SRRAMOils.Pages.MakeVendorPaymentModel
@{
}

<form method="post" novalidate>
	<div class="row g-3" style="border: 2px solid black;border-radius:5px;padding:5px 0 25px 0;">
		<div class="col-12">
			<h3 class="lableFontColor">Payement for Invoice Number :  <span class="font-monospace">@Model.InvoiceNumber</span> </h3>
			<h6>@Model.VendorName (@Model.CityName)</h6>
		</div>
		<div class="col-md-4">
			<label class="form-label">Purchase Amount</label>
			<input id="txtPurchaseAmount" class="form-control" readonly name="PurchaseAmount" value="@Model.PurchaseAmount" />
		</div>
		<div class="col-md-4">
			<label class="form-label">Due Amount</label>
			<input id="txtDueAmount" class="form-control" readonly name="DueAmount" value="@Model.DueAmount" />
		</div>
	</div>
	<div div="divPaymentHistory" class="row g-3" style="padding:35px 0 5px 0;">
		<h6 class="lableFontColor">Enter payment details below:</h6>

		<div class="col-md-6">
			<label for="amount" class="form-label">Amount</label>
			<input type="text" class="form-control" id="txtPayAmount" name="PayAmount" required maxlength="150" placeholder="Amount" />
		</div>

		<div class="col-md-6">
			<label for="payType" class="form-label">Payment Type</label>
			<select id="ddlPayType" name="PayType" required class="form-select">
				<option value="">Select</option>
				<option value="1">Bank</option>
				<option value="2">UPI</option>
				<option value="3">Cash</option>
			</select>
		</div>

		<div class="col-md-6">
			<label for="PaymentReference" class="form-label">Payment Reference</label>
			<input type="text" class="form-control" id="txtPaymentReference" name="PaymentReference" required maxlength="100" placeholder="Payment Reference" />
		</div>

		<div class="col-md-6">
			<label for="PaymentDate" class="form-label">Payment Date</label>
			<input type="date" id="txtPaymentDate" class="form-control" name="PaymentDate" required value="" />
		</div>
		<input type="hidden" name="VendorPurchaseId" value="@Model.VendorPurchaseId" />
		<div class="col-12 mt-3" id="divMakeVendorPayment">
			<button type="Submit" id="btnMakeVendorPayment" class="btn btn-primary">Make Vendor Payment</button>
			<a asp-page="./Index" class="btn btn-secondary ms-2">Cancel</a>
		</div>
	</div>


	@section Scripts {
		<script>
				$('#txtPayAmount').on('input', function() {
			  this.value = this.value.replace(/[^0-9.]/g, '');
			  if ((this.value.match(/\./g) || []).length > 1) {
				this.value = this.value.replace(/\.+$/, "");
			  }
			});


				(function () {
					const form = document.querySelector('form[method="post"]');
					const alertEl = document.getElementById('formAlert');
					const submitBtn = form ? form.querySelector('button[type="submit"]') : null;
					let submitting = false;

					if (!form) return;

					form.addEventListener('submit', function (e) {
						e.preventDefault();
						e.stopPropagation();
						if (!form.checkValidity()) {
							if (alertEl) {
								alertEl.style.display = 'block';
								alertEl.className = 'alert alert-danger';
								alertEl.textContent = 'Please correct the highlighted fields and try again.';
							}
							form.classList.add('was-validated');
							return;
						}

						if (submitting) {
							return;
						}
						submitting = true;
						if (submitBtn) {
							submitBtn.disabled = true;
							submitBtn.dataset.origText = submitBtn.innerHTML;
							submitBtn.innerHTML = 'Saving...';
						}

						const data = $(form).serialize();
						$.ajax({
							url: window.location.pathname,
							method: 'POST',
							data: data,
							success: function (response) {
								if (alertEl) {
									alertEl.style.display = 'block';
								}
								if (response && response.success) {
									if (alertEl) {
										alertEl.className = 'alert alert-success';
										alertEl.textContent = response.message || 'Saved successfully.';
									}
									form.classList.remove('was-validated');
									alert("Success");
									form.reset();
								} else {
									if (alertEl) {
										alertEl.className = 'alert alert-danger';
										alertEl.textContent = response && response.error ? response.error : 'Save failed.';
									}
									alert("Fail");
								}
							},
							error: function (xhr) {
								if (alertEl) {
									alertEl.style.display = 'block';
									alertEl.className = 'alert alert-danger';
									const msg = xhr && xhr.responseText ? xhr.responseText : xhr.statusText || 'An error occurred.';
									alertEl.textContent = 'Error: ' + msg;
								}
							},
							complete: function () {
								submitting = false;
								if (submitBtn) {
									submitBtn.disabled = false;
									submitBtn.innerHTML = submitBtn.dataset.origText || 'Save Purchase';
								}
							}
						});
					}, false);
				})();

		</script>
	}
</form>
@page
@model SRRAMOils.Pages.VendorPurchaseReportModel
@using System.Linq

@* 
PSEUDOCODE / PLAN (detailed):
1. Render existing vendor selection form (preserve current behavior).
2. After the form, render a responsive Bootstrap-styled table bound to Model.VendorPaymentReports.
3. Table columns:
   - Date (formatted)
   - Vendor (use VendorName or fallback to Model-selected vendor)
   - Invoice / Document No
   - Description / Notes
   - Quantity (if available)
   - Unit Price (if available, formatted currency)
   - Amount (formatted currency)
   - Payment Method
   - Status
   - Paid On (date)
4. Loop over Model.VendorPaymentReports:
   - For each report, render each column using null-safe access and sensible formatting.
5. If no reports, show a friendly "No records" row.
6. Add a footer row that shows the total amount (sum of Amount) if numeric values exist.
7. Keep Scripts section for future JS and client-side enhancements.
*@

<form method="post" novalidate>
	<div class="row g-3 mb-3">
		<div class="col-md-12">
			<label for="Vendor" class="form-label">Select Vendor</label>
			<select id="ddlVendorId" name="VendorId" required class="form-select">
				@foreach (var vendor in Model.VendorOptions)
				{
					var selected = vendor.Value == Model.VendorName ? "selected" : null;
					<option value="@vendor.Value" selected="@selected">@vendor.Text</option>
				}
			</select>
		</div>
		<div class="col-md-12">
			<button type="submit" class="btn btn-primary">Generate Report</button>
		</div>
	</div>
</form>

<div class="card mt-4">
	<div class="card-header">
		<h5 class="mb-0">Vendor Payment Reports</h5>
	</div>
	<div class="card-body p-0">
		<div class="table-responsive">
			<table class="table table-striped table-bordered mb-0">
				<thead class="table-light">
					<tr>
						<th scope="col">InvoiceNumber</th>
						<th scope="col">Order Date</th>
						<th scope="col">Purchase Amount</th>
						<th scope="col">Is Payment Done</th>
						<th scope="col" class="text-end">Paid Amount</th>
						<th scope="col" class="text-end">Payment Date</th>
						<th scope="col" class="text-end">Payment Reference Number</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.VendorPaymentReports != null && Model.VendorPaymentReports.Any())
					{
						foreach (var r in Model.VendorPaymentReports)
						{
							<tr>
								<td>@(r.InvoiceNumber ?? "")</td>
								<td>@(r.OrderDate ?? "")</td>
								<td class="text-end">@(r.PurchaseAmount)</td>
								<td></td>
								<td class="text-end">@(r.PaidAmount)</td>
								<td>@(r.PaymentDate ?? "")</td>
								<td>@(r.PaymentReferenceNumber ?? "")</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="10" class="text-center py-3">No payment records found for the selected vendor.</td>
						</tr>
					}
				</tbody>
				@* if (Model.VendorPaymentReports != null && Model.VendorPaymentReports.Any(r => r.Amount.HasValue)){ *@
				
					<tfoot class="table-light" style="display:none">
						<tr>
							<td colspan="6" class="text-end"><strong>Total</strong></td>
							<td class="text-end">
								
									@* var total = Model.VendorPaymentReports.Where(r => r.Amount.HasValue).Sum(r => r.Amount!.Value); *@
								
								@* <strong>string.Format("{0:C}", total)</strong> *@
							</td>
							<td colspan="3"></td>
						</tr>
					</tfoot>
				
			</table>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		// Placeholder for future client-side behaviors (sorting, filtering, export)
	</script>
}

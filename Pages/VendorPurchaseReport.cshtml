@page
@model SRRAMOils.Pages.VendorPurchaseReportModel
@using System.Linq

<form method="post" novalidate>
	<div class="row g-3 mb-3">
		<div class="col-md-12">
			<label for="Vendor" class="form-label">Select Vendor</label>
			<select id="ddlVendorId" name="VendorId" required class="form-select">
				@foreach (var vendor in Model.VendorOptions)
				{
					var selected = vendor.Value == Model.VendorName ? "selected" : null;
					<option value="@vendor.Value" selected="@selected">@vendor.Text</option>
				}
			</select>
		</div>
		<div class="col-md-12">
			<button type="submit" class="btn btn-primary">Generate Report</button>
			<button id="btnDownloadReport" type="button" class="btn btn-primary">Download Report</button>
		</div>
	</div>
</form>

<div class="card mt-4">
	<div class="card-header">
		<h5 class="mb-0">Vendor Payment Reports</h5>
	</div>
	<div class="card-body p-0">
		<div class="table-responsive">
			<table id="tblVendorPurchaseReport" style="border: 2px solid black;border-radius:5px;" class="table table-striped table-bordered mb-0">
				<thead class="table-light">
					<tr>
						<td colspan="8" class="text-center py-3"><h2>@ViewData["SelectedVendorName"].ToString() </h2>  Purchase payment details</td>
					</tr>
					<tr>
						<th scope="col">Invoice #</th>
						<th scope="col">Order Date</th>
						<th scope="col">Bill Amount</th>
						<th scope="col">Paid Amount</th>
						<th scope="col">Due Amount</th>
						<th scope="col">Paid Date</th>
						<th scope="col">Bill Payment Mode</th>
						<th scope="col">Payment Reference #</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.VendorPaymentReports != null && Model.VendorPaymentReports.Any())
					{
						var _inVoiceNumber = "";
						var _displayInvoiceNumber = "";
						var _paidAmount = 0m;
						foreach (var r in Model.VendorPaymentReports)
						{
							if (_inVoiceNumber != r.InvoiceNumber)
							{
								_paidAmount = 0m;
								_inVoiceNumber = r.InvoiceNumber;
								_displayInvoiceNumber = r.InvoiceNumber;
								_paidAmount = _paidAmount + r.PaidAmount;
							}
							else
							{
								_displayInvoiceNumber = "";
								_paidAmount = _paidAmount + r.PaidAmount;

							}
							<tr>
								<td>@_displayInvoiceNumber</td>
								<td>@(r.OrderDate ?? "")</td>
								<td class="text-end">@(r.PurchaseAmount)</td>
								<td class="text-end">@(r.PaidAmount)</td>
								<td>@(r.PurchaseAmount - _paidAmount)    </td>
								<td>@(r.PaymentDate ?? "")</td>
								<td>@(r.BillPaymentMode ?? "")</td>
								<td>@(r.PaymentReferenceNumber ?? "")</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="10" class="text-center py-3">No payment records found for the selected vendor.</td>
						</tr>
					}
				</tbody>
				@* if (Model.VendorPaymentReports != null && Model.VendorPaymentReports.Any(r => r.Amount.HasValue)){ *@

				<tfoot class="table-light" style="display:none">
					<tr>
						<td colspan="6" class="text-end"><strong>Total</strong></td>
						<td class="text-end">

							@* var total = Model.VendorPaymentReports.Where(r => r.Amount.HasValue).Sum(r => r.Amount!.Value); *@

							@* <strong>string.Format("{0:C}", total)</strong> *@
						</td>
						<td colspan="3"></td>
					</tr>
				</tfoot>

			</table>
		</div>
	</div>
</div>


@section Scripts {
	<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
	<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>
	<script>
		var _vendorName = "";
		$('#ddlVendorId').change(function() {
				_vendorName = $('#ddlVendorId option:selected').text();
		});


		$("#btnDownloadReport").click(function() {
			var dt = new Date();
				html2canvas($('#tblVendorPurchaseReport')[0], {
				onrendered: function (canvas) {
					var data = canvas.toDataURL();
					var docDefinition = {
						content: [{
							image: data,
							width: 500
						}]
					};
					pdfMake.createPdf(docDefinition).download("PurchasePayment_"+dt.getDate() + "_" + (dt.getMonth() + 1) + "_" + dt.getFullYear() +"_"+ dt.getHours() + "_" + dt.getMinutes() + "_" + dt.getSeconds()+".pdf");
				}
			});
		});
	</script>
}
